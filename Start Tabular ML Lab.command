#!/bin/bash
# Tabular ML Lab — macOS starter.
#
# First time: right-click this file → Open → Open (macOS asks once because
# the file was downloaded from the internet). Setup runs once (~5 minutes),
# then the app opens in your browser and a "Tabular ML Lab" app icon
# appears in this folder for all future launches.
exec bash "$(dirname "$0")/launcher/posix_launch.sh"
