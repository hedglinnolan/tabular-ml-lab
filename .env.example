# Tabular ML Lab — Environment Configuration
# Copy this file to .env and edit as needed.

# ── App ───────────────────────────────────────────────────────────
APP_PORT=8501
APP_MEMORY_LIMIT=4g

# ── Who can reach the app ─────────────────────────────────────────
# There is no setting here, and that is deliberate. The app does not have
# logins of its own — your institution's single sign-on decides who gets in,
# by sitting in front of the container. See UNIVERSITY_DEPLOYMENT.md.
#
# Earlier versions of this file offered AUTH_MODE=proxy. Nothing in the app
# ever read it, so it looked like a lock and was not one. It is gone rather
# than left to mislead.

# ── LLM Backend ──────────────────────────────────────────────────
# ollama    — Local Ollama (use --profile ollama in docker compose, or external)
# vllm      — Institutional vLLM endpoint
# openai    — OpenAI API
# anthropic — Anthropic API
# disabled  — No LLM features
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://ollama:11434
# VLLM_BASE_URL=http://vllm-server:8000/v1
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama sidecar settings (only if using --profile ollama)
OLLAMA_PORT=11434
OLLAMA_MEMORY_LIMIT=8g

# To give the app more memory, raise APP_MEMORY_LIMIT above. (A COMPUTE_PROFILE
# setting used to live here; like AUTH_MODE, nothing read it.)
