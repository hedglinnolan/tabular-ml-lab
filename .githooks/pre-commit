#!/usr/bin/env bash
# The commit gates: every tracked Python file parses, and the prose is written in American English.
#
# Enable in a fresh clone (git does not version .git/hooks, so this file lives
# in .githooks/ and is pointed at):
#
#     git config core.hooksPath .githooks
#
# Two gates since the legacy TurboTab app was retired (BLUEPRINT §9.1). The
# ledger, register, copy-deck and evidence-badge gates checked the legacy app's
# own records (docs/turbotab/tools/) and were retired with it, as was the
# pre-push routing value check, which measured the legacy door's routing. The
# v2 checks — pytest over turbotab/core and turbotab/server, `npm run check` in
# turbotab/frontend — run with the work (BLUEPRINT §8), not in a hook.
#
# A gate is chained through `run`, which records a failure in FAILED; a gate
# chained by a newline instead of `&&` once let a red gate through (8127101).
#
# Bypass is `git commit --no-verify`, and it should appear in a commit message
# with a reason when it is used.
set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

# shellcheck source=lib.sh
. "$(dirname "$0")/lib.sh"
if ! PY=$(resolve_python); then
    printf '\nCOMMIT REFUSED — no Python interpreter found for the gates.\n'
    printf '  Set TURBOTAB_PYTHON to one, or create ./venv.\n'
    exit 1
fi

# A gate that CANNOT RUN must not print the same cross and the same "COMMIT
# REFUSED" as a gate that FAILED: the first says nothing about the code.
if ! gates_can_run "$PY"; then
    printf '\nGATES CANNOT RUN — this is not a failure of your code.\n'
    printf '  %s cannot import %s, so the gates cannot execute.\n' \
           "$PY" "${GATES_MISSING:-their dependencies}"
    printf '  This is usually a linked worktree with no environment of its own.\n'
    printf '  Set TURBOTAB_PYTHON to a provisioned interpreter, or run the\n'
    printf '  gates from the main checkout. Nothing was checked, so nothing is\n'
    printf '  being asserted about this commit.\n'
    exit 1
fi

FAILED=0
run() {
    local label="$1"; shift
    local out
    if ! out=$("$@" 2>&1); then
        printf '\n  ✗ %s\n' "$label"
        printf '%s\n' "$out" | tail -25 | sed 's/^/      /'
        FAILED=1
    else
        printf '  ✓ %s\n' "$label"
    fi
}

printf 'pre-commit gates:\n'
# `ast.parse` over every tracked .py file: it names the file and the line, and
# says nothing about whether the code is CORRECT — run the tests for that. The
# checker is taken from beside this hook, like lib.sh, because `core.hooksPath`
# may point every worktree at one checkout's hooks, including worktrees whose
# tree predates the checker's move here; it checks the tree being committed.
run "python parses"      "$PY" "$(dirname "$0")/parsecheck.py"
# The spelling check and its matcher control, in full. The file's enumeration
# control is deselected: it pins two legacy documents by the paths they had
# before the archive (docs/turbotab/LOOP.md and prompts/AGENT_ONBOARD.md), and
# tests/ is Classic's, so the pin is not edited here. Both documents are still
# scanned, at docs/turbotab/archive/.
run "American spelling"  "$PY" -m pytest tests/test_american_spelling.py -q --no-header \
    --deselect tests/test_american_spelling.py::test_the_enumeration_covers_the_source_and_nothing_ignored

if [ "$FAILED" -ne 0 ]; then
    cat <<'EOF'

COMMIT REFUSED — a gate is red.

  `python parses` names the file and the line that do not parse.
  `American spelling` names the file, the line and the American form; a British
  spelling quoted as evidence belongs under docs/audit/, the exempt path.

  To commit anyway: git commit --no-verify — and say why in the message.
EOF
    exit 1
fi
exit 0
